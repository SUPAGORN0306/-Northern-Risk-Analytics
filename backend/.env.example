# Neon PostgreSQL pooled connection string
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Google AI Studio Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_VISION_TIMEOUT_MS=180000
GEMINI_VISION_PAGE_RETRIES=2
GEMINI_VISION_RETRY_BASE_SECONDS=30
GEMINI_VISION_MAX_RETRY_WAIT_SECONDS=300
GEMINI_VISION_TRANSIENT_COOLDOWN_SECONDS=900
OCR_REVIEW_MAX_PAGES=100

# FastAPI CORS allowlist
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN_REGEX=https://(northrisk|northern-risk-analytics)[a-z0-9-]*\.vercel\.app

# Staff RBAC authentication (keep ALLOW_DEMO_STAFF_ACCESS=false in production)
ALLOW_DEMO_STAFF_ACCESS=false
STAFF_AUTH_SECRET=change_me_in_production
STAFF_DEMO_USERNAME=analyst
STAFF_DEMO_PASSWORD=change_me_in_production
STAFF_ANALYST_USERNAME=analyst
STAFF_ANALYST_PASSWORD=change_me_in_production
STAFF_STEWARD_USERNAME=steward
STAFF_STEWARD_PASSWORD=change_me_in_production
STAFF_ADMIN_USERNAME=admin
STAFF_ADMIN_PASSWORD=change_me_in_production
